// Symbolic tactical-safety layer for the highway-merge RL agent, written in
// Scallop's Datalog dialect.
//
// Modeled directly on Scallop's own PacMan-Maze example
// (scallop/experiments/pacman_maze/run.py -- safe node / edge / path /
// next_action pattern): discrete lane-legality and safety reasoning lives
// here; continuous speed/gap control stays in the existing IDM longitudinal
// controller (highway_env.py / longitudinal_controller.py), per the
// Scallop paper's own guidance that it's "well-suited for discrete and
// logical rules but less effective for numerical properties."
//
// Lane numbers use i32, not usize, specifically so `l - 1` at the leftmost
// lane (0) is a valid negative value with no fact support, rather than an
// unsigned-underflow risk.

type Action = SHORT_GAP | MEDIUM_GAP | LONG_GAP | INC_SPEED | DEC_SPEED | LANE_LEFT | LANE_RIGHT | MAINTAIN

// Structural fact: 3 lanes always exist (highway_env.py road_params['nb_lanes'] = 3).
// Static and certain, so it's declared directly rather than supplied per-step.
rel lane_exists = {(0,), (1,), (2,)}

// --- Probabilistic input facts, supplied each step from a small neural head
// over the observation (see neurosymbolic_policy.py) ---
type ego_lane(l: i32)
type unsafe_gap(l: i32)     // lane l currently has a vehicle too close to occupy
type leader_close(x: i32)   // singleton: the leader in ego's own lane is too close to safely speed up

// --- Derived safety relations ---
rel safe_lane(l) = lane_exists(l) and not unsafe_gap(l)
rel can_change_left() = ego_lane(l), safe_lane(l - 1)
rel can_change_right() = ego_lane(l), safe_lane(l + 1)
rel can_increase_speed() = not leader_close(_)

// --- Endorsed actions ---
// Lane changes and speed-up are gated on the safety relations above; the
// remaining tactical actions (gap targets, slow down, maintain) have no
// hard safety precondition, so they're always endorsed -- Scallop isn't
// vetoing them, it's specifically constraining the two actions measured as
// our dominant failure mode (invalid/unsafe lane change).
rel next_action(LANE_LEFT) = can_change_left()
rel next_action(LANE_RIGHT) = can_change_right()
rel next_action(INC_SPEED) = can_increase_speed()
rel next_action(SHORT_GAP) = ego_lane(_)
rel next_action(MEDIUM_GAP) = ego_lane(_)
rel next_action(LONG_GAP) = ego_lane(_)
rel next_action(DEC_SPEED) = ego_lane(_)
rel next_action(MAINTAIN) = ego_lane(_)

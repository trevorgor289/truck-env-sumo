// Weighted-rules variant of merge_planner.scl, used ONLY by
// neurosymbolic_policy_scallop_only.py (PPO scallop-only). The shared
// merge_planner.scl (used by every other policy in this repo: DQN combine,
// DQN scallop-only, PPO combine, PPO learned-combine) is untouched.
//
// Every derivation rule below carries its own learnable confidence weight,
// ANDed into the rule body as an auxiliary 0-ary-style fact (the standard
// Scallop pattern for a *learned*, per-forward-pass rule weight -- a literal
// `rel 0.9 :: head = body` tag can only be a compile-time constant, so a
// weight that's supposed to be updated by gradient descent has to come in
// as an input fact instead, same mechanism as unsafe_gap/leader_close, just
// not derived from the observation). The rule's own existing logic (lane
// topology, safety facts) is unchanged and still required -- these weights
// multiply an additional learned confidence on top, they don't replace
// anything.
//
// Each w_* fact's probability is supplied by neurosymbolic_policy_scallop_only.py
// from a randomly-initialized nn.Parameter (sigmoid-constrained to [0,1]),
// one per rule, trained like any other parameter in the policy.

type Action = SHORT_GAP | MEDIUM_GAP | LONG_GAP | INC_SPEED | DEC_SPEED | LANE_LEFT | LANE_RIGHT | MAINTAIN

// Structural fact: 3 lanes always exist (highway_env.py road_params['nb_lanes'] = 3).
// Left as a hard/certain fact -- this is a real, certain property of the
// road, not something to be uncertain about.
rel lane_exists = {(0,), (1,), (2,)}

// --- Probabilistic input facts, supplied each step from a small neural head
// over the observation ---
type ego_lane(l: i32)
type unsafe_gap(l: i32)     // lane l currently has a vehicle too close to occupy
type leader_close(x: i32)   // singleton: the leader in ego's own lane is too close to safely speed up

// --- Learned rule-confidence weights (randomly initialized, trained) ---
type w_safe_lane(x: i32)
type w_can_change_left(x: i32)
type w_can_change_right(x: i32)
type w_can_increase_speed(x: i32)
type w_next_short_gap(x: i32)
type w_next_medium_gap(x: i32)
type w_next_long_gap(x: i32)
type w_next_inc_speed(x: i32)
type w_next_dec_speed(x: i32)
type w_next_lane_left(x: i32)
type w_next_lane_right(x: i32)
type w_next_maintain(x: i32)

// --- Derived safety relations, each gated by its own learned weight ---
rel safe_lane(l) = lane_exists(l) and not unsafe_gap(l) and w_safe_lane(_)
rel can_change_left() = ego_lane(l), safe_lane(l - 1), w_can_change_left(_)
rel can_change_right() = ego_lane(l), safe_lane(l + 1), w_can_change_right(_)
rel can_increase_speed() = not leader_close(_) and w_can_increase_speed(_)

// --- Endorsed actions, each gated by its own learned weight ---
rel next_action(LANE_LEFT) = can_change_left(), w_next_lane_left(_)
rel next_action(LANE_RIGHT) = can_change_right(), w_next_lane_right(_)
rel next_action(INC_SPEED) = can_increase_speed(), w_next_inc_speed(_)
rel next_action(SHORT_GAP) = ego_lane(_), w_next_short_gap(_)
rel next_action(MEDIUM_GAP) = ego_lane(_), w_next_medium_gap(_)
rel next_action(LONG_GAP) = ego_lane(_), w_next_long_gap(_)
rel next_action(DEC_SPEED) = ego_lane(_), w_next_dec_speed(_)
rel next_action(MAINTAIN) = ego_lane(_), w_next_maintain(_)
